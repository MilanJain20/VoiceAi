# ============================================================
# Voice AI Platform — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ---- PostgreSQL ----
# Local-only password for docker compose. Do not reuse it anywhere else.
# POSTGRES_PASSWORD or DATABASE_URL is required; there is no password default in code.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=voiceai
POSTGRES_PASSWORD=voiceai_dev_password
POSTGRES_DB=voiceai
DATABASE_URL=postgresql+asyncpg://voiceai:voiceai_dev_password@localhost:5432/voiceai

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---- Azure OpenAI (via LangChain AzureChatOpenAI) ----
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.2

# ---- Deepgram ----
DEEPGRAM_API_KEY=your-deepgram-key
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SAMPLE_RATE=16000

# ---- Edge TTS (free, no API key needed) ----
# See all voices: edge-tts --list-voices
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz

# ---- JWT ----
# Leave empty in development to generate an ephemeral secret for this process.
# Required when APP_ENV is staging or production. Use a long random value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth is off by default. Set true to require Bearer tokens on routes that use it.
AUTH_ENABLED=false

# Redis is optional. false uses the in-process memory store.
USE_REDIS=false

# Set true only if an intercepting TLS proxy breaks Deepgram or Edge TTS.
# Leave false otherwise. Do not enable in production.
INSECURE_SKIP_TLS_VERIFY=false
